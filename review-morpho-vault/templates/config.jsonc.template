{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "{{SLUG}}",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": ["{{VAULT_ADDRESS}}"],
  "maxAddresses": 100,
  "maxDepth": 3,
  "overrides": {
    // Underlying asset (usually a stablecoin or LSD) — never want to walk into the token graph
    "{{ASSET_ADDRESS}}": {
      "ignoreDiscovery": true
    },
    "{{VAULT_ADDRESS}}": {
      "ignoreMethods": [
        "convertToShares",
        "convertToAssets",
        "previewDeposit",
        "previewMint",
        "previewRedeem",
        "previewWithdraw"
      ],
      "fields": {
        "supplyQueue": {
          "handler": {
            "type": "array",
            "method": "supplyQueue",
            "length": "{{ supplyQueueLength }}"
          }
        },
        "withdrawQueue": {
          "handler": {
            "type": "array",
            "method": "withdrawQueue",
            "length": "{{ withdrawQueueLength }}"
          }
        },
        "marketParams": {
          "handler": {
            "type": "morphoMarkets",
            "morphoAddressField": "MORPHO",
            "queueField": "withdrawQueue",
            "ignoreRelative": true
          }
        },
        "marketOracles": {
          "handler": {
            "type": "morphoMarkets",
            "extractField": "oracle",
            "sourceField": "marketParams"
          }
        },
        "allocators": {
          "handler": {
            "type": "event",
            "select": "allocator",
            "add": {
              "event": "SetIsAllocator",
              "where": ["=", "#isAllocator", true]
            },
            "remove": {
              "event": "SetIsAllocator",
              "where": ["!=", "#isAllocator", true]
            }
          }
        },
        "MAX_TIMELOCK": {
          "handler": { "type": "hardcoded", "value": 1209600 },
          "description": "Maximum timelock delay (2 weeks)"
        },
        "MIN_TIMELOCK": {
          "handler": { "type": "hardcoded", "value": 86400 },
          "description": "Minimum timelock delay (1 day)"
        },
        "MAX_QUEUE_LENGTH": {
          "handler": { "type": "hardcoded", "value": 30 },
          "description": "Maximum number of markets in supply/withdraw queue"
        },
        "MAX_FEE": {
          "handler": { "type": "hardcoded", "value": "500000000000000000" },
          "description": "Maximum fee (50%, represented as 0.5e18)"
        },
        "fee": { "severity": "HIGH" }
      },
      "ignoreInWatchMode": ["totalAssets", "totalSupply", "lastTotalAssets"]
    }
  }
}
